# Copy to .env -- never commit .env
ANTHROPIC_API_KEY=      # Get free credits at console.anthropic.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=          # Your Gmail address (or other SMTP-accessible account)
SMTP_PASSWORD=          # App-specific password -- myaccount.google.com/apppasswords
FROM_EMAIL=
TO_EMAIL=
MAX_ITERATIONS=5
MAX_TOKENS_PER_RUN=10000
